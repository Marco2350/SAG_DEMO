# ── URL base y app ─────────────────────────────────
# Déjala VACÍA para autodetectar la URL desde el servidor (recomendado): así
# funciona igual en localhost/subcarpeta que en la raíz de un dominio, sin tocar
# nada al clonar o desplegar. Sólo fíjala (ej: "https://midominio.com") si hay un
# proxy/CDN que altere el host o el esquema y la autodetección falle.
BASE_URL=""
APP_NAME="SAG Honduras Sin Hambre"
APP_ENV="development"

# ── Base de datos ──────────────────────────────────
DB_HOST=""
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASS=""
DB_CHARSET="utf8mb4"

# ── Trazaragro / OIRSA ─────────────────────────────
# IMPORTANTE: pruebas y producción usan client_id/client_secret DIFERENTES.
# No es solo cambiar la URL — también las credenciales de cliente.
#
# Pruebas:
#   TRAZARAGRO_BASE_URL="https://pruebas-trazaragro.oirsa.org"
#   TRAZARAGRO_CLIENT_ID="TZWEB"
#   TRAZARAGRO_CLIENT_SECRET="<provista por OIRSA para pruebas>"
#
# Producción:
#   TRAZARAGRO_BASE_URL="https://trazaragro.oirsa.org"
#   TRAZARAGRO_CLIENT_ID="HNPIP"
#   TRAZARAGRO_CLIENT_SECRET="<provista por OIRSA para HNPIP>"
#
# Si se dejan vacíos username/password, el cliente trabaja en MOCK.
TRAZARAGRO_BASE_URL=""
TRAZARAGRO_USERNAME=""
TRAZARAGRO_PASSWORD=""
TRAZARAGRO_CLIENT_ID=""
TRAZARAGRO_CLIENT_SECRET=""
TRAZARAGRO_INSTANCE="HN"
TRAZARAGRO_TIMEOUT="30"
